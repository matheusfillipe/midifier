# CUDA image for an NVIDIA card. The torch wheel on PyPI already carries CUDA on Linux, so the
# model installs with its own dependencies and nothing needs pinning.
FROM python:3.12-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends ffmpeg curl && \
    rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# The service user is a system account with no home, so anything defaulting to $HOME/.cache
# fails outright. The weights are large and gated, so they belong on a mounted volume.
ENV VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH \
    HF_HOME=/models/huggingface \
    XDG_CACHE_HOME=/models/cache

RUN uv venv $VIRTUAL_ENV

ARG MUSCRIPTOR=0.3.0
RUN uv pip install "muscriptor==${MUSCRIPTOR}" && \
    python -c "import torch, torchaudio, muscriptor; print('torch', torch.__version__, 'cuda', torch.version.cuda)"

WORKDIR /app
COPY . .
RUN uv pip install -e .

RUN adduser --system --uid 1000 app && \
    mkdir -p /models && \
    chown -R app /app /opt/venv /models
USER app

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/v1/health || exit 1

CMD ["python", "-m", "midifier", "api"]
