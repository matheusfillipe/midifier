# GPU image. The CPU image (./Dockerfile) is fine for the API, but transcription on a
# processor runs at roughly twenty times the length of the song on a shared node, so the
# worker needs this one.
#
# Size matters here. A stock ROCm image carries kernels for every AMD architecture and
# lands near 34GB; TheRock publishes per-family indexes, and building against gfx110X
# alone brings the whole environment to about 5.4GB.
FROM python:3.12-slim

# libatomic is what torch's ROCm loader dlopens first; without it the import fails with a
# missing-library error that reads nothing like the real cause.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ffmpeg \
        libatomic1 \
        curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# PYTORCH_HIP_ALLOC_CONF: the gfx1103 APU does not support the virtual-memory
# reservation APIs torch's allocator uses by default, and with them enabled every
# allocation fails as out-of-memory while reporting the whole GTT pool free.
#
# HF_HOME / XDG_CACHE_HOME: the service user is a system account with no home, so
# anything defaulting to $HOME/.cache fails outright. The weights are large and gated,
# so they belong on a mounted volume rather than in the image.
ENV VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH \
    PYTORCH_HIP_ALLOC_CONF=expandable_segments:False \
    HF_HOME=/models/huggingface \
    XDG_CACHE_HOME=/models/cache

RUN uv venv $VIRTUAL_ENV

# gfx110X only, and pinned. Not the multi-arch index, which is what makes these images
# enormous. The pin matters more than the size: this is a nightly channel, and the build
# a week later than this one hangs the GPU mid-transcription hard enough to trigger a
# driver reset, while small kernels still pass. Move it only with a full transcription
# run to prove it.
ARG ROCM_TORCH=2.11.0+rocm7.13.0a20260416
RUN uv pip install --index-url https://rocm.nightlies.amd.com/v2/gfx110X-all/ \
        "torch==${ROCM_TORCH}" \
        "torchaudio==${ROCM_TORCH}"

# muscriptor pulls its own torch, which would replace the ROCm build with a CPU one, so
# its dependencies are installed explicitly instead.
RUN uv pip install --no-deps muscriptor && \
    uv pip install \
        einops \
        huggingface-hub \
        mido \
        numpy \
        packaging \
        python-multipart \
        safetensors \
        soundfile \
        typer

WORKDIR /app
COPY . .

# The project's own dependencies resolve normally; none of them touch torch, so the ROCm
# build installed above is left alone. Only muscriptor needed --no-deps.
RUN uv pip install -e .

RUN adduser --system --uid 1000 app && \
    mkdir -p /models && \
    chown -R app /app /opt/venv /models
USER app

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/v1/health || exit 1

CMD ["python", "-m", "midifier", "api"]
