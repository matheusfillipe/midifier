# All settings are prefixed MIDIFIER_. Everything here is optional; the service runs
# with no configuration at all, storing results on local disk.

# --- service ---
# MIDIFIER_PORT=8000
# MIDIFIER_LOG_LEVEL=info
# Hash of the API key. Callers present the key itself; this is only its digest.
# Generate with: python -m midifier keygen
# MIDIFIER_API_KEY_HASH=

# --- storage: "local" (default) or "s3" ---
# MIDIFIER_STORAGE_BACKEND=local
# MIDIFIER_LOCAL_STORAGE_DIR=./data

# Names match kinesthesia's own MinIO variables, since both address the same bucket.
# MIDIFIER_STORAGE_BACKEND=s3
# MIDIFIER_MINIO_ENDPOINT=minio.example.com
# MIDIFIER_MINIO_ACCESS_KEY=
# MIDIFIER_MINIO_SECRET_KEY=
# MIDIFIER_MINIO_BUCKET=midis
# MIDIFIER_MINIO_PUBLIC_BASE=https://minio.example.com/midis
# MIDIFIER_MINIO_USE_SSL=true
# MIDIFIER_MINIO_REGION=us-east-1

# --- transcription ---
# MIDIFIER_MODEL_SIZE=large
# MIDIFIER_DEVICE=auto
# Length of each decoded segment. Shorter caps how far a mistake travels; longer gives the
# model more context to place a part in.
# MIDIFIER_SEGMENT_SECONDS=60
# Tries per segment. A decode that dies on the accelerator is retried in a fresh process,
# because the same audio usually decodes on the next attempt.
# MIDIFIER_DECODE_ATTEMPTS=3
# Required to download the gated transcription weights.
# MIDIFIER_HF_TOKEN=

# --- limits ---
# MIDIFIER_MAX_UPLOAD_BYTES=104857600
# MIDIFIER_MAX_DURATION_SECONDS=360
# MIDIFIER_ALLOW_URL_INPUT=true
